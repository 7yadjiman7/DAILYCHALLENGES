    "# ── Overfitting vs underfitting illustration ───────────────────\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.linear_model import Ridge\n",
    "\n",
    "np.random.seed(42)\n",
    "x_raw = np.sort(np.random.uniform(0, 10, 40))\n",
    "y_raw = np.sin(x_raw) + np.random.randn(40) * 0.4\n",
    "x_plot = np.linspace(0, 10, 300)\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "titles = ['Underfitting (degree=1)', 'Good fit (degree=4)', 'Overfitting (degree=15)']\n",
    "degrees = [1, 4, 15]\n",
    "colors  = ['#C44E52', '#55A868', '#DD8452']\n",
    "\n",
    "for ax, deg, title, color in zip(axes, degrees, titles, colors):\n",
    "    pipe = Pipeline([('poly', PolynomialFeatures(deg)),\n",
    "                     ('ridge', Ridge(alpha=1e-3 if deg < 10 else 1e-10))])\n",
    "    pipe.fit(x_raw.reshape(-1,1), y_raw)\n",
    "    y_hat = pipe.predict(x_plot.reshape(-1,1))\n",
    "\n",
    "    ax.scatter(x_raw, y_raw, s=30, color='steelblue', zorder=5, label='Data')\n",
    "    ax.plot(x_plot, np.sin(x_plot), 'k--', linewidth=1.5,\n",
    "            alpha=0.5, label='True function')\n",
    "    ax.plot(x_plot, y_hat, color=color, linewidth=2.5, label=f'Degree {deg}')\n",
    "    ax.set_title(title, fontsize=12, fontweight='bold', color=color)\n",
    "    ax.set_ylim(-2.5, 2.5)\n",
    "    ax.legend(fontsize=8)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle('Underfitting vs Good Fit vs Overfitting', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
